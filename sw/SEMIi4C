import torch
import torch.nn as nn

print("=" * 70)
print("NAFNET COMPUTATIONAL COMPLEXITY ANALYSIS")
print("=" * 70)

device = next(nafnet.parameters()).device
nafnet.eval()

# ---------------------------------------------------------
# MAC counter
# ---------------------------------------------------------

layer_stats = []

def conv_hook(name):
    def hook(module, inputs, output):

        x = inputs[0]

        # Output shape: [B, Cout, Hout, Wout]
        batch = output.shape[0]
        cout = output.shape[1]
        hout = output.shape[2]
        wout = output.shape[3]

        kh, kw = module.kernel_size
        cin = module.in_channels
        groups = module.groups

        # Effective input channels per group
        cin_per_group = cin // groups

        # MACs per output element
        mac_per_output = kh * kw * cin_per_group

        # Total MACs
        macs = (
            batch
            * cout
            * hout
            * wout
            * mac_per_output
        )

        layer_stats.append({
            "name": name,
            "type": "Depthwise" if groups == cin else "Conv2D",
            "input_channels": cin,
            "output_channels": cout,
            "kernel": (kh, kw),
            "groups": groups,
            "H": hout,
            "W": wout,
            "parameters": sum(p.numel() for p in module.parameters()),
            "MACs": macs
        })

    return hook


# ---------------------------------------------------------
# Register hooks
# ---------------------------------------------------------

hooks = []

for name, module in nafnet.named_modules():

    if isinstance(module, nn.Conv2d):

        hooks.append(
            module.register_forward_hook(
