        groups = module.groups

        cin_per_group = cin // groups

        macs = (
            batch
            * cout
            * hout
            * wout
            * kh
            * kw
            * cin_per_group
        )

        weight_params = sum(
            p.numel()
            for p in module.parameters()
        )

