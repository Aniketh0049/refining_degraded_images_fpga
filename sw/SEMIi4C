# Full NAFNet training with validation + checkpointing

import copy
import numpy as np
import torch

NUM_EPOCHS = 20

# Start fresh optimizer for the longer experiment
optimizer_naf = torch.optim.Adam(
    nafnet.parameters(),
    lr=1e-4
)

# Reduce LR when validation loss stops improving
scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
    optimizer_naf,
    mode="min",
    factor=0.5,
    patience=3
)

criterion_naf = torch.nn.L1Loss()

# Best-model tracking
best_val_loss = float("inf")
best_psnr = -float("inf")
best_ssim = -float("inf")

best_state = None
best_epoch = 0

# History
train_losses = []
val_losses = []
psnr_history = []
ssim_history = []
lr_history = []


for epoch in range(NUM_EPOCHS):

    # =====================================================
    # TRAIN
    # =====================================================

    nafnet.train()

    running_train_loss = 0.0

    for noisy_batch, gt_batch in train_loader:

        noisy_batch = noisy_batch.to(
            device,
            non_blocking=True
        )

        gt_batch = gt_batch.to(
            device,
            non_blocking=True
        )

        # Forward
        output = nafnet(noisy_batch)

        # Loss
        loss = criterion_naf(
            output,
            gt_batch
        )

        # Backprop
        optimizer_naf.zero_grad(
            set_to_none=True
        )

        loss.backward()

        optimizer_naf.step()

        running_train_loss += loss.item()


    avg_train_loss = (
        running_train_loss /
        len(train_loader)
    )


    # =====================================================
    # VALIDATION
    # =====================================================

    nafnet.eval()

    running_val_loss = 0.0

    psnr_values = []
    ssim_values = []

    with torch.no_grad():

        for noisy_batch, gt_batch in val_loader:

            noisy_batch = noisy_batch.to(device)
            gt_batch = gt_batch.to(device)

            output = nafnet(noisy_batch)

            # Validation loss
            loss = criterion_naf(
                output,
                gt_batch
            )

            running_val_loss += loss.item()

            # Convert to NumPy
            output_np = output.cpu().numpy()
            gt_np = gt_batch.cpu().numpy()

            # Per-image metrics
            for i in range(output_np.shape[0]):

                pred = output_np[i, 0]
                target = gt_np[i, 0]

                psnr_value = calculate_psnr(
                    pred,
                    target,
                    data_range=1.0
                )

                ssim_value = ssim(
                    target,
                    pred,
                    data_range=1.0
                )

                psnr_values.append(
                    psnr_value
                )

                ssim_values.append(
                    ssim_value
                )


    avg_val_loss = (
        running_val_loss /
        len(val_loader)
    )

    avg_psnr = np.mean(psnr_values)
    avg_ssim = np.mean(ssim_values)


    # =====================================================
    # LEARNING RATE
    # =====================================================

    scheduler.step(avg_val_loss)

    current_lr = optimizer_naf.param_groups[0]["lr"]


    # =====================================================
    # SAVE HISTORY
    # =====================================================

    train_losses.append(avg_train_loss)
    val_losses.append(avg_val_loss)
    psnr_history.append(avg_psnr)
    ssim_history.append(avg_ssim)
    lr_history.append(current_lr)


    # =====================================================
    # BEST MODEL
    # =====================================================

    if avg_val_loss < best_val_loss:

        best_val_loss = avg_val_loss
        best_psnr = avg_psnr
        best_ssim = avg_ssim

        best_epoch = epoch + 1

        best_state = copy.deepcopy(
            nafnet.state_dict()
        )

        torch.save(
            best_state,
            DATASET_ROOT / "best_nafnet.pth"
        )

        best_marker = "  <-- BEST"


    else:

        best_marker = ""


    # =====================================================
    # PRINT RESULTS
    # =====================================================

    print(
        f"Epoch [{epoch+1:02d}/{NUM_EPOCHS}] "
        f"Train L1: {avg_train_loss:.6f} | "
        f"Val L1: {avg_val_loss:.6f} | "
        f"PSNR: {avg_psnr:.3f} dB | "
        f"SSIM: {avg_ssim:.4f} | "
        f"LR: {current_lr:.2e}"
        f"{best_marker}"
    )


print("\n========================================")
print("20-EPOCH TRAINING COMPLETE")
print("========================================")

