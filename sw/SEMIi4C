# Validation
# ---------------------------------------------------------

print("\nRunning quantized validation...")

quant_l1_total = 0.0
quant_count = 0

quant_psnr_values = []
quant_ssim_values = []

quant_model.to(device)
quant_model.eval()

with torch.no_grad():

    for batch_idx, (noisy, gt) in enumerate(val_loader):

        noisy = noisy.to(device)
        gt = gt.to(device)

        output = quant_model(noisy)

        # -------------------------------------------------
        # Clamp final restored image
        # -------------------------------------------------

        output = torch.clamp(
            output,
            0.0,
            1.0
        )

        # -------------------------------------------------
        # L1
        # -------------------------------------------------

        l1 = torch.mean(
            torch.abs(output - gt)
        )

        quant_l1_total += (
            l1.item() * noisy.size(0)
        )

        quant_count += noisy.size(0)

        # -------------------------------------------------
        # PSNR
        # -------------------------------------------------

        mse = torch.mean(
            (output - gt) ** 2,
            dim=(1, 2, 3)
        )

        psnr = 10.0 * torch.log10(
            1.0 / (mse + 1e-12)
        )

        quant_psnr_values.extend(
            psnr.cpu().numpy().tolist()
        )

        # -------------------------------------------------
        # Simple SSIM approximation
        # -------------------------------------------------

        # Uses local statistics through average pooling.

        mu_x = torch.nn.functional.avg_pool2d(
            output,
            kernel_size=7,
            stride=1,
            padding=3
        )

        mu_y = torch.nn.functional.avg_pool2d(
            gt,
            kernel_size=7,
            stride=1,
            padding=3
        )

        sigma_x = torch.nn.functional.avg_pool2d(
            output * output,
            kernel_size=7,
            stride=1,
            padding=3
        ) - mu_x * mu_x

        sigma_y = torch.nn.functional.avg_pool2d(
            gt * gt,
            kernel_size=7,
            stride=1,
            padding=3
        ) - mu_y * mu_y

        sigma_xy = torch.nn.functional.avg_pool2d(
            output * gt,
            kernel_size=7,
            stride=1,
            padding=3
        ) - mu_x * mu_y

        C1 = 0.01 ** 2
        C2 = 0.03 ** 2

        ssim_map = (
            (2 * mu_x * mu_y + C1) *
            (2 * sigma_xy + C2)
        ) / (
            (mu_x * mu_x + mu_y * mu_y + C1) *
            (sigma_x + sigma_y + C2)
        )

        ssim_value = ssim_map.mean(
            dim=(1, 2, 3)
        )

        quant_ssim_values.extend(
            ssim_value.cpu().numpy().tolist()
        )

        if (batch_idx + 1) % 10 == 0:

