# Dataset with paired geometric augmentation

import random
import numpy as np
import torch
from torch.utils.data import Dataset


class KLARestorationDataset(Dataset):

    def __init__(
        self,
        names,
        noisy_dir,
        gt_dir,
        augment=False
    ):
        self.names = names
        self.noisy_dir = noisy_dir
        self.gt_dir = gt_dir
        self.augment = augment

    def __len__(self):
        return len(self.names)

    def __getitem__(self, idx):

        name = self.names[idx]

        # ----------------------------------------------------
        # Load paired images
        # ----------------------------------------------------

        noisy = np.load(
            self.noisy_dir / f"{name}.npy"
        ).astype(np.float32)

        gt = np.load(
            self.gt_dir / f"{name}.npy"
        ).astype(np.float32)

        # ----------------------------------------------------
        # Paired geometric augmentation
        # ----------------------------------------------------

        if self.augment:

            # Horizontal flip
            if random.random() < 0.5:
                noisy = np.fliplr(noisy).copy()
                gt = np.fliplr(gt).copy()

            # Vertical flip
            if random.random() < 0.5:
                noisy = np.flipud(noisy).copy()
                gt = np.flipud(gt).copy()

            # Random 90° rotation
            k = random.randint(0, 3)

            if k > 0:
                noisy = np.rot90(noisy, k).copy()
                gt = np.rot90(gt, k).copy()

        # ----------------------------------------------------
        # Convert to PyTorch
        # ----------------------------------------------------

        noisy = torch.from_numpy(noisy).unsqueeze(0)
        gt = torch.from_numpy(gt).unsqueeze(0)

        return noisy, gt

# Create training and validation datasets

