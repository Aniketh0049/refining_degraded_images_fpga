# Integer hardware golden model
# INT16 activation × INT8 weight → INT32 accumulation → INT16 output

import numpy as np

print("=" * 70)
print("HARDWARE GOLDEN MODEL")
print("=" * 70)


# =========================================================
# Fixed-point helpers
# =========================================================

INT8_MIN = -128
INT8_MAX = 127

INT16_MIN = -32768
INT16_MAX = 32767

INT32_MIN = -(2**31)
INT32_MAX = (2**31) - 1


def saturate_int16(x):

    return np.clip(
        x,
        INT16_MIN,
        INT16_MAX
    ).astype(np.int16)


def quantize_int8(x, scale):

    q = np.round(
        x / scale
    )

    q = np.clip(
        q,
        INT8_MIN,
        INT8_MAX
    )

    return q.astype(np.int8)


def quantize_int16(x, scale):

    q = np.round(
        x / scale
    )

    q = np.clip(
        q,
        INT16_MIN,
        INT16_MAX
    )

    return q.astype(np.int16)


def dequantize_int16(x, scale):

    return (
        x.astype(np.float32) * scale
    )


# =========================================================
# Integer 1×1 convolution
# =========================================================

def conv1x1_int16_int8(
    x,
    weights,
    bias=0
):

    """
    x:
        [Cin, H, W] INT16

    weights:
        [Cout, Cin] INT8

    bias:
        INT32

    output:
        [Cout, H, W] INT32
    """

    cin, h, w = x.shape

    cout = weights.shape[0]

    output = np.zeros(
        (cout, h, w),
        dtype=np.int64
    )

    for oc in range(cout):

        for ic in range(cin):

            output[oc] += (
                x[ic].astype(np.int64)
                *
                weights[oc, ic].astype(np.int64)
            )

        output[oc] += int(bias[oc])

    return output


# =========================================================
# Integer 3×3 convolution
# =========================================================

def conv3x3_int16_int8(
    x,
    weights,
    bias=None,
    groups=1
):

    """
    x:
        [Cin, H, W]

    weights:
        [Cout, Cin/groups, 3, 3]

    groups:
        1 for standard convolution
        Cin for depthwise convolution
    """

    cin, h, w = x.shape

    cout = weights.shape[0]

    output = np.zeros(
        (cout, h, w),
        dtype=np.int64
    )

    if bias is None:

        bias = np.zeros(
            cout,
            dtype=np.int64
        )

    # Zero padding
    padded = np.pad(
        x.astype(np.int64),
        (
            (0, 0),
            (1, 1),
            (1, 1)
        ),
        mode="constant"
    )

    cin_per_group = cin // groups

    cout_per_group = cout // groups

    for oc in range(cout):

        group = oc // cout_per_group

        ic_start = (
            group * cin_per_group
        )

        ic_end = (
            ic_start + cin_per_group
        )

        for ic_local, ic in enumerate(
            range(ic_start, ic_end)
        ):

            kernel = weights[
                oc,
                ic_local
            ].astype(np.int64)

            for ky in range(3):

                for kx in range(3):

                    output[oc] += (
                        padded[
                            ic,
                            ky:ky+h,
                            kx:kx+w
                        ]
                        *
                        kernel[ky, kx]
                    )

        output[oc] += int(
            bias[oc]
        )

    return output


# =========================================================
# Requantization
# =========================================================

def requantize_int32_to_int16(
    accumulator,
    input_scale,
    weight_scale,
    output_scale
):

    """
    Real relationship:

        real_output =
            accumulator
            × input_scale
            × weight_scale

    Convert back to INT16 using output_scale.
    """

    real_scale = (
        input_scale
        * weight_scale
    )

    output_float = (
        accumulator.astype(np.float64)
        * real_scale
        / output_scale
    )

    output_int16 = np.round(
        output_float
    )

    return saturate_int16(
        output_int16
    )


