# NAFNet building blocks

import torch
import torch.nn as nn


class SimpleGate(nn.Module):
    def forward(self, x):
        x1, x2 = x.chunk(2, dim=1)
        return x1 * x2


class SimplifiedChannelAttention(nn.Module):

    def __init__(self, channels):
        super().__init__()

        self.pool = nn.AdaptiveAvgPool2d(1)

        self.conv = nn.Conv2d(
            channels,
            channels,
            kernel_size=1,
            bias=True
        )

    def forward(self, x):

        scale = self.pool(x)
        scale = self.conv(scale)

        return x * scale


class NAFBlock(nn.Module):

    def __init__(
        self,
        channels,
        dw_expand=2,
        ffn_expand=2
    ):
        super().__init__()

        dw_channels = channels * dw_expand
        ffn_channels = channels * ffn_expand

        # ------------------------------------------------
        # First branch
        # ------------------------------------------------

        self.norm1 = nn.GroupNorm(
            1,
            channels
        )

        self.conv1 = nn.Conv2d(
            channels,
            dw_channels,
            kernel_size=1
        )

        self.dwconv = nn.Conv2d(
            dw_channels,
            dw_channels,
            kernel_size=3,
            padding=1,
            groups=dw_channels
        )

        self.sg1 = SimpleGate()

        self.sca = SimplifiedChannelAttention(
            dw_channels // 2
        )

        self.conv2 = nn.Conv2d(
            dw_channels // 2,
            channels,
            kernel_size=1
        )

        self.beta = nn.Parameter(
            torch.zeros(
                (1, channels, 1, 1)
            )
        )

        # ------------------------------------------------
        # Second branch
        # ------------------------------------------------

        self.norm2 = nn.GroupNorm(
            1,
            channels
        )

        self.conv3 = nn.Conv2d(
            channels,
            ffn_channels,
            kernel_size=1
        )

        self.sg2 = SimpleGate()

        self.conv4 = nn.Conv2d(
            ffn_channels // 2,
            channels,
            kernel_size=1
        )

        self.gamma = nn.Parameter(
            torch.zeros(
                (1, channels, 1, 1)
            )
        )

    def forward(self, x):

        # First residual branch
        y = self.norm1(x)

        y = self.conv1(y)
        y = self.dwconv(y)

        y = self.sg1(y)
        y = self.sca(y)

        y = self.conv2(y)

        x = x + y * self.beta

        # Second residual branch
        y = self.norm2(x)

        y = self.conv3(y)
        y = self.sg2(y)
        y = self.conv4(y)

        x = x + y * self.gamma

        return x

# Compact NAFNet for 2× restoration

class NAFNetSR(nn.Module):

    def __init__(
        self,
        img_channel=1,
        width=32,
        num_blocks=8
    ):
        super().__init__()

        self.intro = nn.Conv2d(
            img_channel,
            width,
            kernel_size=3,
            padding=1
        )

        self.blocks = nn.Sequential(
            *[
                NAFBlock(width)
                for _ in range(num_blocks)
            ]
        )

        self.ending = nn.Conv2d(
            width,
            width,
            kernel_size=3,
            padding=1
        )

        # 2× PixelShuffle
        #
        # 1 output channel × 2² = 4 channels
        self.up = nn.Conv2d(
            width,
            4,
            kernel_size=3,
            padding=1
        )

        self.pixel_shuffle = nn.PixelShuffle(2)

        self.final = nn.Conv2d(
            1,
            1,
            kernel_size=3,
            padding=1
        )

    def forward(self, x):

        x = self.intro(x)

        x = self.blocks(x)

        x = self.ending(x)

        x = self.up(x)

        x = self.pixel_shuffle(x)

        x = self.final(x)

        return x

