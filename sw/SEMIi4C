import torch
import torch.nn as nn
import copy
import numpy as np

print("=" * 70)
print("INT8 WEIGHT / INT16 ACTIVATION QUANTIZATION TEST")
print("=" * 70)

# ---------------------------------------------------------
# Helper: symmetric fake quantization
# ---------------------------------------------------------

def fake_quantize_tensor(x, scale, qmax):
    """
    Quantize and immediately dequantize.
    This simulates finite-precision arithmetic while
    keeping the network executable in floating point.
    """

    if scale <= 0:
        return x

    q = torch.round(x / scale)

    q = torch.clamp(
        q,
        -qmax,
        qmax
    )

    return q * scale


# ---------------------------------------------------------
# Quantized model copy
# ---------------------------------------------------------

quant_model = copy.deepcopy(nafnet)
quant_model.eval()


# ---------------------------------------------------------
# Quantize model parameters
# ---------------------------------------------------------

with torch.no_grad():

    for name, param in quant_model.named_parameters():

        if name not in weight_scales:
            continue

        scale = weight_scales[name]

        q = torch.round(
            param / scale
        )

        q = torch.clamp(
            q,
            -127,
            127
        )

        param.copy_(
            q * scale
        )


# ---------------------------------------------------------
# Activation hooks
# ---------------------------------------------------------

activation_hooks = []


def make_activation_quant_hook(name):

    def hook(module, inputs, output):

        if name not in activation_scales:
            return output

        scale = activation_scales[name]

        return fake_quantize_tensor(
            output,
            scale,
            32767
        )

    return hook


# ---------------------------------------------------------
# Register activation fake quantization
# ---------------------------------------------------------

for name, module in quant_model.named_modules():

    if isinstance(
        module,
        (
            nn.Conv2d,
            nn.GroupNorm
        )
    ):

        if name in activation_scales:

            activation_hooks.append(
                module.register_forward_hook(
                    make_activation_quant_hook(name)
                )
            )


