# Simple 2× restoration baseline

import torch
import torch.nn as nn


class BaselineSR(nn.Module):

    def __init__(self):
        super().__init__()

        self.features = nn.Sequential(

            nn.Conv2d(
                1, 64,
                kernel_size=3,
                padding=1
            ),

            nn.ReLU(inplace=True),

            nn.Conv2d(
                64, 64,
                kernel_size=3,
                padding=1
            ),

            nn.ReLU(inplace=True),

            nn.Conv2d(
                64, 64,
                kernel_size=3,
                padding=1
            ),

            nn.ReLU(inplace=True),
        )

        # 4 channels are required for
        # PixelShuffle(2):
        #
        # 1 output channel × 2² = 4

        self.upsample = nn.Conv2d(
            64,
            4,
            kernel_size=3,
            padding=1
        )

        self.pixel_shuffle = nn.PixelShuffle(2)

        self.output = nn.Conv2d(
            1,
            1,
            kernel_size=3,
            padding=1
        )

    def forward(self, x):

        x = self.features(x)

        x = self.upsample(x)

        x = self.pixel_shuffle(x)

        x = self.output(x)

        return x

